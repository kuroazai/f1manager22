# Copy to .env and fill in. .env is gitignored.
#
# The original shipped a config.py you had to edit. That is a tracked file, so
# your own path conflicted on every pull, and anyone who committed by habit
# published the path to their home directory.

# Where the game keeps its saves. On Windows this is usually:
#   C:\Users\<you>\Documents\My Games\F1 Manager 2022\Saved\SaveGames
F1M22_SAVE_FOLDER=

# Which save to work on. Override per run with --save.
F1M22_SAVE_NAME=autosave.sav

# xAranaktu's unpacker, which is a separate project and is not included here.
# Download script.py from:
#   https://github.com/xAranaktu/F1-Manager-2022-SaveFile-Repacker
F1M22_UNPACKER=

# A driver profile JSON file. Blank uses the one bundled with the package.
F1M22_PROFILES=
